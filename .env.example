# Copy to .env (git-ignored) and fill in. `npm start` loads it automatically.

# --- required
PS_BASE_URL=https://smith.pureservice.com
PS_API_KEY=

# --- safety (defaults shown)
# false = DRY-RUN: everything is parsed and logged, nothing is posted. Set to true only when ready.
BOT_WRITE_ENABLED=false
# Pilot: comma-separated PureService user ids allowed to use the bot. Empty = everyone.
BOT_ALLOWED_USER_IDS=
# The API key's own user id (notes by this user are always ignored). Learned automatically if empty.
BOT_USER_ID=

# --- storage / runtime
BOT_DB_PATH=data/bot.db
BOT_TIMEZONE=Europe/Oslo
# Time used when a reminder names a date but no time (e.g. "!remindme fredag")
BOT_DEFAULT_TIME=08:00
BOT_HEALTH_PORT=8080
BOT_LOG_LEVEL=info
# First start only: process notes after this id. Default: start at the newest note (no backfill).
BOT_START_FROM_ID=

# --- budgets (defaults shown; PureService allows 100 requests/min)
BOT_REQUESTS_PER_MINUTE=40
BOT_NOTES_PER_MINUTE=20
BOT_NOTES_PER_TICKET_PER_HOUR=5
BOT_COMMANDS_PER_USER_PER_HOUR=20
BOT_MAX_COMMANDS_PER_NOTE=3
BOT_OUTBOX_BACKLOG_LIMIT=200
BOT_POLL_INTERVAL_SEC=30
BOT_RETENTION_DAYS=90

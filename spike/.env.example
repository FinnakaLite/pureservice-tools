# Copy to spike/.env and fill in. spike/.env is git-ignored — never commit the key.
# Base URL of the Agent app (with or without /agent/api)
PS_BASE_URL=https://YOURCOMPANY.pureservice.com
# Administration → Security → API keys. Give it a short expiry for the spike.
PS_API_KEY=
# Request number (the number shown in the UI) of a TEST ticket you created yourself
PS_TEST_TICKET=
